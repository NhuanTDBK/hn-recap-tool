# Application Settings
APP_NAME=HackerNews Digest
APP_VERSION=1.0.0
DEBUG=false

# Security - IMPORTANT: Generate a secure secret key for production
# You can generate one with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=postgresql+asyncpg://hn_pal:hn_pal_dev@localhost:5433/hn_pal

# Redis
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# Data Storage
DATA_DIR=../data
USER_DATA_FILE=users/user-profiles.jsonl

# HackerNews API
HN_API_BASE_URL=http://hn.algolia.com/api/v1
HN_API_TIMEOUT=10
HN_MAX_POSTS=30
HN_MAX_COMMENTS=50

# Content Extraction
CONTENT_EXTRACTION_TIMEOUT=15

# CORS - Update with your frontend URL in production
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Logging
LOG_LEVEL=INFO

# OpenAI & LLM
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_DEFAULT_TEMPERATURE=0.7
OPENAI_DEFAULT_MAX_TOKENS=500
# Prices per 1M tokens for cost tracking; models without a price are recorded at cost 0 (with a warning)
# MODEL_PRICING_JSON={"my-model": {"input": 0.30, "output": 1.20}}

# Langfuse Observability (Optional)
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-your-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-key-here
LANGFUSE_HOST=https://cloud.langfuse.com

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-token-here
TELEGRAM_CHANNEL_ID=@your-channel-here
TELEGRAM_NETWORK_RETRY_ATTEMPTS=3
TELEGRAM_NETWORK_RETRY_BASE_DELAY_SECONDS=1.0
TELEGRAM_POLLING_RESTART_DELAY_SECONDS=3.0
TELEGRAM_FORCE_IPV4=true

# Bot access control. Comma-separated Telegram user ids allowed to DM the bot.
# EMPTY = open to everyone. The group chat below is always allowed.
# TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
# TELEGRAM_USER_RATE_LIMIT_PER_MINUTE=30   # per user; 0 disables

# Telegram group feed (optional). Add the bot to the group, then copy a message link
# from the target topic: https://t.me/c/<A>/<TOPIC>/<MSG> -> chat id -100<A>, topic id <TOPIC>.
# TELEGRAM_GROUP_CHAT_ID=-1001234567890
# TELEGRAM_GROUP_TOPIC_ID=42
# TELEGRAM_GROUP_SUMMARY_STYLE=basic
# Set to false to stop DM summaries/pushes and serve only the group feed
# TELEGRAM_DM_DELIVERY_ENABLED=true

# Recommendations: picks learned from the group's Save / "Not for me" taps, sent hourly, right after the summaries
# to their own forum topic (create a "Recommended" topic and copy its id as above).
# RECOMMENDATION_ENABLED=false
# TELEGRAM_RECOMMENDATION_TOPIC_ID=43
# RECOMMENDATION_MODEL=deepseek-v4-pro   # ranking model; unset = OPENAI_MODEL
# RECOMMENDATION_DAILY_MAX=0         # optional ceiling per day across all runs; 0 = no limit (only strong matches are sent)
# RECOMMENDATION_MIN_FIT=3           # the model rates picks 3-5; lower ratings are dropped (3 = send everything it returns)
# RECOMMENDATION_MIN_GAP_MINUTES=120 # skip a run this soon after the last one
# RECOMMENDATION_TIMEZONE=Asia/Ho_Chi_Minh
# RECOMMENDATION_MIN_SAVES=5
# RECOMMENDATION_LOOKBACK_HOURS=36
# RECOMMENDATION_IGNORED_DAYS=14
# Exploration: mix in good posts outside the reader's profile (docs/recommendation-exploration.md)
# RECOMMENDATION_EXPLORE_ENABLED=false
# RECOMMENDATION_EXPLORE_RATIO=0.2          # share of all picks that explore (raised automatically while the record is thin)
# RECOMMENDATION_EXPLORE_MAX_PER_DAY=3      # hard ceiling on explore picks per local day
# RECOMMENDATION_EXPLORE_MIN_QUALITY=4      # lowest 1-5 quality rating that may be explored
# RECOMMENDATION_EXPLORE_COOLDOWN_DAYS=30   # days a rejected explore topic is left alone
# RECOMMENDATION_TOPIC_HALF_LIFE_DAYS=30    # days for a topic outcome's weight to halve

# Max summary characters shown after "Show More" (Telegram caps a message at 4096)
# TELEGRAM_FULL_SUMMARY_MAX_LENGTH=4000

# Crawler Service
CRAWLER_CONTAINER_NAME=hnpal-crawler
CRAWLER_INTERVAL_SECONDS=3600
CRAWLER_MEM_LIMIT=256m
